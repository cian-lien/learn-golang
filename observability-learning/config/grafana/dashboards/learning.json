{
  "uid": "go-observability-learning",
  "title": "Go Observability Learning",
  "tags": ["go", "learning"],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "refresh": "5s",
  "time": {"from": "now-15m", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Requests per second by route",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "learning-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (http_route) (rate(demo_requests_total{job=\"learning-app\"}[1m]))", "legendFormat": "{{http_route}}"}]
    },
    {
      "id": 2,
      "title": "Error ratio (HTTP 500)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "learning-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum(rate(demo_requests_total{job=\"learning-app\",http_response_status_code=\"500\"}[1m])) / clamp_min(sum(rate(demo_requests_total{job=\"learning-app\"}[1m])), 0.000001)", "legendFormat": "error ratio"}]
    },
    {
      "id": 3,
      "title": "Average latency by route",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "learning-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "sum by (http_route) (rate(demo_request_duration_seconds_sum{job=\"learning-app\"}[1m])) / clamp_min(sum by (http_route) (rate(demo_request_duration_seconds_count{job=\"learning-app\"}[1m])), 0.000001)", "legendFormat": "{{http_route}}"}]
    },
    {
      "id": 4,
      "title": "Estimated P95 latency by route",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "learning-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}, "overrides": []},
      "targets": [{"refId": "A", "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(demo_request_duration_seconds_bucket{job=\"learning-app\"}[1m])))", "legendFormat": "{{http_route}}"}]
    }
  ]
}
